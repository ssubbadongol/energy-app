# Soft Focus — client environment
#
# Only EXPO_PUBLIC_* values are readable by the app, and everything with that
# prefix ends up inside the shipped bundle. Nothing secret goes here.
#
# The Gemini key deliberately is NOT in this file. It lives in Secret Manager
# and is only ever read by the mentorChat / moderatePodMessage Cloud Functions.
#
# Local `expo start` runs the *development* variant (see app.config.ts), so the
# values below are the ones your dev build uses. EAS build profiles set
# APP_VARIANT themselves; put per-profile values in EAS environment variables
# rather than here.

# --- Firebase ------------------------------------------------------------
# REQUIRED. There is no fallback in code — a hardcoded default is how a build
# ends up quietly talking to the wrong backend.
#
# Firebase Console -> Project settings -> Your apps -> Web app ->
# "SDK setup and configuration" -> Config. Copy the six values across.
#
# Not secrets: they identify the project, and Firestore rules plus App Check
# are what protect it. They live here because they are environment, not because
# they are sensitive.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- RevenueCat ----------------------------------------------------------
# *Public* SDK keys — safe to ship, they can only read entitlements.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# --- App Check -----------------------------------------------------------
# Debug token, for simulators and CI only.
# Register it under Firebase Console -> App Check -> Manage debug tokens.
# Must be empty in any build you ship.
EXPO_PUBLIC_APP_CHECK_DEBUG_TOKEN=
