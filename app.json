{
  "expo": {
    "name": "energy-app",
    "slug": "soft-focus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "energyapp",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "googleServicesFile": "./GoogleService-Info.plist",
      "entitlements": {
        "com.apple.developer.devicecheck.appattest-environment": "production"
      },
      "bundleIdentifier": "com.tsuyo7.energyapp"
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.tsuyo7.energyapp",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#7fb096"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f7faf7",
          "dark": {
            "backgroundColor": "#2e3b34"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-audio",
        {
          "_comment": "Playback only (one chime, in components/sage/Celebration.tsx). Without these the plugin still adds NSMicrophoneUsageDescription and the dangerous RECORD_AUDIO permission.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "@react-native-firebase/app",
        {
          "_comment": "disableSPM puts $RNFirebaseDisableSPM = true in the Podfile, so Firebase resolves through CocoaPods instead of Swift Package Manager. RNFirebase v26 defaults to SPM, and SPM cannot be combined with the use_frameworks! :linkage => :static that this project needs — every RNFB pod embeds its own copy of firebase-ios-sdk and they collide as duplicate symbols. Fails at pod install with 'SPM + static linkage is not supported'.",
          "ios": { "disableSPM": true }
        }
      ],
      "@react-native-firebase/app-check",
      "@react-native-firebase/crashlytics",
      "@react-native-firebase/analytics",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "appVariant": "development",
      "eas": {
        "projectId": "6910202e-71e6-4c79-b7bd-c306a35e8696"
      }
    },
    "owner": "koyonix"
  }
}
