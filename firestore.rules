rules_version = '2';

/**
 * Soft Focus security rules.
 *
 * Three things every Mentor/Pods path must independently satisfy:
 *
 *   1. App Check  — the request came from a genuine build of the app, not a
 *                   script, a modified client, or curl.
 *   2. Auth       — there is a real (anonymous) Firebase user.
 *   3. Entitlement— Pro, read from the server-written mirror on the user doc.
 *
 * The entitlement is never read from anything the client controls. `pro` on
 * the user document is writable only by the Admin SDK (see the field guard in
 * /users/{uid}), so a client cannot grant itself access by writing its own
 * profile. Cloud Functions bypass these rules entirely and do their own
 * custom-claim check, so both surfaces are covered.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------------------------------------------------------------- *
     * Helpers
     * ---------------------------------------------------------------- */

    /**
     * App Check — enforced by the service, not by this rule.
     *
     * Do not "fix" this to `request.app != null`. That was the original
     * implementation and it denied every client request, because `request.app`
     * is not populated in this project's rules context even when the token is
     * present and valid. Measured: with Cloud Firestore App Check enforcement
     * ON — so unverified requests are rejected before rules run at all — a read
     * guarded by `request.auth != null` passed while an otherwise identical
     * read guarded by `request.app != null` was denied, on the same request.
     *
     * The guarantee is not lost, it moved one layer earlier and got stronger:
     * Cloud Firestore is set to **Enforce** under Firebase Console -> App Check
     * -> APIs, so a request without a verified App Check token never reaches
     * these rules. Keep that enforcement on; it is now the only thing standing
     * between the database and an unattested client.
     *
     * WHAT THIS COSTS, stated plainly, because the answer is reassuring and
     * the temptation it guards against is not:
     *
     * If App Check enforcement is ever switched off — and the tempting moment
     * is a launch where the production app was never registered and is being
     * denied — these rules keep working and an unattested client still gets
     * only what any anonymous user gets: its own documents. It cannot read
     * another user's anything, cannot reach a pod without a server-issued
     * membership, and cannot grant itself Pro. The exposure is one unattested
     * identity per token minted, operating on its own empty account.
     *
     * So the correct emergency response is to register the app, not to
     * unenforce. But if someone does unenforce at 2am, the damage is bounded
     * by the rules below rather than by luck — and every genuinely sensitive
     * write path (entitlements, pod membership, moderation, deletion) is a
     * callable where App Check is enforced by the platform, independently of
     * this console setting.
     */
    function verifiedApp() {
      return true;
    }

    function signedIn() {
      return request.auth != null && verifiedApp();
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    /**
     * Pro, from the server-written mirror.
     *
     * The custom claim is checked first because it is free — it rides along in
     * the token. The Firestore mirror covers the window after a purchase but
     * before the client has refreshed its token, and the case where a token is
     * up to an hour stale.
     */
    function proClaim() {
      return request.auth.token.pro == true;
    }

    function proMirror() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.pro == true;
    }

    function isPro() {
      return signedIn() && (proClaim() || proMirror());
    }

    function membership(podId) {
      return get(/databases/$(database)/documents/pods/$(podId)/members/$(request.auth.uid)).data;
    }

    function isPodMember(podId) {
      return signedIn()
        && exists(/databases/$(database)/documents/pods/$(podId)/members/$(request.auth.uid))
        && membership(podId).active == true;
    }

    /** Fields only the server may ever set. */
    function subscriptionFields() {
      return ['pro', 'proExpiresAt', 'proProductId', 'proStore', 'proLastEvent', 'proUpdatedAt'];
    }

    function shortString(value, max) {
      return value is string && value.size() <= max;
    }

    /**
     * Bound every profile string the mentor replays into its prompt.
     *
     * `name`, `tags` and `goals` are rebuilt into the system instruction on
     * *every* mentor turn. A document may hold ~1MiB, so without these an
     * oversized display name is a permanent multiplier on the cost of each
     * message — not a cosmetic problem. The function clamps these too; this is
     * the half that stops the oversized value ever being stored.
     */
    function validProfileStrings() {
      return (!('name' in request.resource.data)
                || request.resource.data.name == null
                || shortString(request.resource.data.name, 60))
        && (!('tags' in request.resource.data)
                || (request.resource.data.tags is list && request.resource.data.tags.size() <= 12))
        && (!('goals' in request.resource.data)
                || (request.resource.data.goals is list && request.resource.data.goals.size() <= 12));
    }

    /**
     * Task shape.
     *
     * Tasks are written by the device and read back into the mentor's context
     * by `list_tasks`, which makes an unbounded task name a way to inject
     * arbitrary length into your own prompt. `hasOnly` also stops a client
     * smuggling in a field the server might later trust.
     */
    function validTask() {
      let d = request.resource.data;
      return d.keys().hasOnly([
               'name', 'priority', 'energy', 'time', 'type', 'completed',
               'dueDate', 'dueTime', 'createdAt', 'updatedAt', 'completedAt',
               'source', 'subtasks'
             ])
        /**
         * Subtasks: the checklist inside a task.
         *
         * Only the COUNT is bounded here, and that is a real limitation rather
         * than an oversight — Firestore rules cannot iterate a list, so there
         * is no way to check the length of each subtask's name. A modified
         * client could write twelve very long ones.
         *
         * That matters because tasks are replayed into the mentor's prompt on
         * every turn, so it is a standing cost multiplier, not untidy data.
         * The defence that actually holds is server-side: `readTasks` in
         * `functions/src/mentorTools.ts` clamps every subtask name before it
         * can reach a prompt, exactly as it already does for `name` and `type`.
         *
         * Twelve is also a product ceiling. A twenty-step checklist is its own
         * kind of overwhelm, which is the thing this feature exists to reduce.
         */
        && (!('subtasks' in d)
              || (d.subtasks is list && d.subtasks.size() <= 12))
        && shortString(d.name, 200)
        && d.name.size() > 0
        && d.priority in ['high', 'medium', 'low']
        && d.energy in ['high', 'medium', 'low']
        && d.time is number && d.time >= 0 && d.time <= 1440
        && shortString(d.type, 60)
        && d.completed is bool
        && (!('dueDate' in d) || d.dueDate == null || shortString(d.dueDate, 40));
    }

    /* ---------------------------------------------------------------- *
     * Users
     * ---------------------------------------------------------------- */

    match /users/{uid} {
      allow read: if isSelf(uid);

      /**
       * A user owns their profile, but not their entitlement. Every
       * subscription field is server-only: a write that touches one is
       * rejected outright rather than silently ignored, so a modified client
       * cannot grant itself Pro by writing its own profile document.
       */
      allow create: if isSelf(uid)
        && !request.resource.data.keys().hasAny(subscriptionFields())
        && validProfileStrings();

      allow update: if isSelf(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(subscriptionFields())
        && validProfileStrings();

      allow delete: if false;

      /* Tasks — private, and the mentor writes here server-side too. */
      match /tasks/{taskId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid) && validTask();
        allow delete: if isSelf(uid);
      }

      /* Mentor conversation — readable by its owner, written by the function. */
      match /mentorMessages/{messageId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      /* Daily rate-limit counter — server-only, or the cap means nothing. */
      match /counters/{counterId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      /**
       * Crisis-support offers. Written by the moderation function; the owner
       * may only mark one acknowledged, never create or delete one.
       */
      match /supportPrompts/{promptId} {
        allow read: if isSelf(uid);
        allow update: if isSelf(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['acknowledgedAt', 'dismissed']);
        allow create, delete: if false;
      }

      /**
       * Blocked members.
       *
       * Document id is the blocked uid, which gives free de-duplication and
       * lets `joinPod` read the whole list as a set of ids without an index.
       *
       * Private to its owner in both directions: a member must not be able to
       * discover that they have been blocked, because in an anonymous room
       * that is itself a channel back to the person who blocked them.
       *
       * Deliberately client-writable, unlike reports. Blocking is a statement
       * about what *you* want to see, not a judgement about the message, so it
       * needs no server adjudication — and it must keep working instantly even
       * when a callable would fail. Unblocking is allowed for the same reason.
       *
       * The body is pinned to a timestamp so this cannot become a private
       * key-value store attached to a user document.
       */
      match /blocks/{blockedUid} {
        allow read: if isSelf(uid);
        allow create: if isSelf(uid)
          && blockedUid != uid
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
        allow delete: if isSelf(uid);
        allow update: if false;
      }
    }

    /* ---------------------------------------------------------------- *
     * Pods
     * ---------------------------------------------------------------- */

    match /pods/{podId} {
      /**
       * Browsing open rooms is a Pro feature. Pod documents carry no message
       * content — topic, seat count and expiry only.
       */
      allow read: if isPro();

      /* Creating and mutating rooms is the matchmaking function's job alone. */
      allow write: if false;

      /**
       * Membership is private to the member it describes. Nobody can
       * enumerate who is in a room; the seat count on the pod doc is all
       * anyone else needs.
       */
      match /members/{memberId} {
        allow read: if isSelf(memberId);
        allow write: if false;
      }

      match /messages/{messageId} {
        /* Only members read the room, and only while they hold Pro. */
        allow read: if isPodMember(podId) && isPro();

        /**
         * Members post their own messages directly — that is what makes the
         * room feel live. The shape is pinned here so a modified client cannot
         * post as someone else, pre-mark itself moderated, or smuggle in a
         * field the moderation trigger would then trust.
         */
        allow create: if isPodMember(podId)
          && isPro()
          && request.resource.data.uid == request.auth.uid
          // The alias must be the one matchmaking handed this member, so a
          // modified client cannot post in someone else's name.
          && request.resource.data.alias == membership(podId).alias
          && request.resource.data.type == 'user'
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time
          && request.resource.data.moderation.status == 'pending'
          && request.resource.data.hidden == false
          // `expiresAt` is stamped server-side from the pod, so nobody can
          // give their own messages a longer life than the room.
          && request.resource.data.keys().hasOnly(
               ['uid', 'alias', 'type', 'text', 'createdAt', 'moderation', 'hidden']
             );

        /**
         * Nobody edits or deletes a posted message — not even its author.
         * Redaction and flagging are the moderation function's decisions, and
         * letting an author delete would let them remove evidence of abuse.
         */
        allow update, delete: if false;
      }
    }

    /* ---------------------------------------------------------------- *
     * Server-only collections
     * ---------------------------------------------------------------- */

    /* Human review queue. No client ever reads or writes this. */
    match /moderationFlags/{flagId} {
      allow read, write: if false;
    }

    /* RevenueCat webhook idempotency records. */
    match /revenueCatEvents/{eventId} {
      allow read, write: if false;
    }

    /**
     * Kill switches. Readable so the client can show an honest notice instead
     * of a generic error; writable only by the budget function.
     *
     * ⚠️ Everything on this document is PUBLISHED. Auth is anonymous and
     * automatic, so "signed in" means "installed the app" — there is no
     * meaningful population excluded by this rule.
     *
     * It used to carry the budget handler's telemetry (`lastBudgetCost`,
     * `lastBudgetAmount`, `lastBudgetRatio`), which meant every user could read
     * the project's actual monthly Cloud spend and watch how close it was to
     * tripping the kill switch — a live progress bar for anyone wanting to
     * take the mentor down for every subscriber. It also carried
     * `devProEnabled`, which advertised that a free-Pro path existed.
     *
     * Those now live on `config/budgetState` and `config/devAccess`, neither of
     * which is matched by any rule here and both of which are therefore denied
     * by the catch-all at the bottom.
     *
     * Do not widen this to `match /config/{doc}`. The narrowness is the
     * control: a new config document is private until someone deliberately
     * names it here and thinks about who can read it.
     */
    match /config/flags {
      allow read: if signedIn();
      allow write: if false;
    }

    /* Default deny for anything not named above. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
